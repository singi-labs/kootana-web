# Netlify environment variables for the waitlist function.
# Set these in the Netlify site UI (Site settings > Environment variables) or via
# the Netlify CLI/MCP. This file documents what's needed; do NOT commit real values.

# Listmonk API user + key (an API user with subscribers:manage + lists:manage_all).
LISTMONK_API_USER=
LISTMONK_API_KEY=

# Cloudflare bypass token for n.a11y.nl (sent as X-Bypass-Token).
CF_BYPASS_TOKEN=

# HMAC key for signing/verifying ALTCHA proof-of-work challenges (generate a fresh
# random string for Kootana, e.g. `openssl rand -hex 32`).
ALTCHA_HMAC_KEY=
