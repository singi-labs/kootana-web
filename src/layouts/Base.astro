---
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '../../tokens/kootana.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kootana — your network, at every event',
  description = 'Kootana makes your professional network useful at the events you already attend. See who you already know in the room, connect in a tap, and keep a record that follows you across every event.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1C1B1A" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--k-font-sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--k-text);
    background: var(--k-bg);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3 {
    font-family: var(--k-font-display);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 2px solid var(--k-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  .container {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .eyebrow {
    font-family: var(--k-font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--k-accent);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    border-radius: var(--k-radius-full);
    border: 1.5px solid transparent;
    font-family: var(--k-font-sans);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 120ms ease-out,
      border-color 120ms ease-out,
      color 120ms ease-out;
  }

  .btn-primary {
    background: var(--k-accent);
    color: var(--k-accent-fg);
  }

  .btn-primary:hover {
    background: var(--k-accent-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--k-text);
    border-color: var(--k-border-strong);
  }

  .btn-secondary:hover {
    border-color: var(--k-accent);
    color: var(--k-accent);
  }
</style>
